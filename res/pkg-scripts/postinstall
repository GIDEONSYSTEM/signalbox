#!/bin/sh
# Отдать установленный бандл пользователю, который ставил.
#
# 🔴 БЕЗ ЭТОГО ПРОГРАММА НЕ МОЖЕТ СЕБЯ ОБНОВИТЬ. Пакеты macOS распаковываются от
# root, поэтому /Applications/SignalBox.app достаётся root:wheel. Обновление же
# работает от имени пользователя: оно копирует новый бандл поверх старого
# (rsync в plat::copyTree). Записи нет — rsync возвращает Permission denied,
# copyTree отдаёт false, установщик молча выходит, версия остаётся прежней.
# Ровно это и поймали на живом обновлении 1.0.6 -> 1.0.8 (§14).
#
# Так делают все программы, которые обновляют себя сами: либо бандл принадлежит
# пользователю, либо нужен привилегированный помощник с отдельным запросом прав.
# Помощник — это большая отдельная работа и лишний вектор атаки; для студийной
# утилиты достаточно владения.
#
# Аргументы, которые даёт Installer: $1 — путь к пакету, $2 — куда ставили
# (у нас /Applications), $3 — том.

APP="$2/SignalBox.app"
[ -d "$APP" ] || exit 0

# $USER в скриптах пакета — тот, кто запустил установку. Если пусто (например,
# установка через installer(8) из-под root), берём пользователя консоли.
OWNER="$USER"
[ -z "$OWNER" ] || [ "$OWNER" = "root" ] && OWNER="$(stat -f %Su /dev/console 2>/dev/null)"

# root тут означает «настоящего пользователя не нашли» — тогда лучше ничего не
# трогать, чем отдать бандл непонятно кому.
if [ -n "$OWNER" ] && [ "$OWNER" != "root" ]; then
    chown -R "$OWNER" "$APP" 2>/dev/null
    # Группу не трогаем: на macOS у пользователя она staff, этого достаточно.
    chmod -R u+w "$APP" 2>/dev/null
fi

exit 0
