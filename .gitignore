# --- результаты сборки ---
# Папку build не храним, КРОМЕ build/Release/www — там лежит сам интерфейс панели,
# он редактируется руками и является исходником, просто исторически живёт рядом с exe.
/build/*
!/build/Release/
/build/Release/*
!/build/Release/www/

# Сборка под macOS целиком генерируемая: бинарник, dylib Sony (одна на 18 МБ) и
# копия www, которую CMake кладёт туда из build/Release/www при каждой сборке.
/build-mac/

# Готовые архивы релиза (tools/pack-mac.sh) — их место в GitHub Releases.
/dist/

# --- данные конкретной установки, а не код ---
# (они и так внутри build/Release, но перечислим явно — на случай переноса)
cameras.txt
cameras-known.txt
groups.json
settings.json
firewall-skip.txt
*.log
*.log.prev

# --- прочее ---
.vs/
*.user
*.zip
Thumbs.db
desktop.ini
.DS_Store
